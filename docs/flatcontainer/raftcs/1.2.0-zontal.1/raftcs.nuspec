<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>RaftCs</id>
    <version>1.2.0-zontal.1</version>
    <authors>marcschier</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <readme>README.md</readme>
    <projectUrl>https://github.com/marcschier/raft-cs</projectUrl>
    <description>High-performance, NativeAOT-ready Raft consensus (https://raft.github.io) for modern .NET — a customizable core consensus module (election, log replication, snapshots, joint membership) with replaceable storage and transport, modeled on tikv/raft-rs.</description>
    <copyright>Copyright (c) marcschier</copyright>
    <tags>raft consensus distributed-systems replication state-machine leader-election aot span high-performance</tags>
    <repository type="git" url="https://github.com/zontal/raft-cs" commit="da39804cee64692d20a1222367c47727fa965de2" />
    <dependencies>
      <group targetFramework="net10.0" />
      <group targetFramework="net8.0" />
      <group targetFramework="net9.0" />
      <group targetFramework=".NETStandard2.0">
        <dependency id="Microsoft.Bcl.AsyncInterfaces" version="10.0.12" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Bcl.HashCode" version="6.0.0" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Bcl.TimeProvider" version="10.0.12" exclude="Build,Analyzers" />
        <dependency id="System.Memory" version="4.6.3" exclude="Build,Analyzers" />
        <dependency id="System.Runtime.CompilerServices.Unsafe" version="6.1.2" exclude="Build,Analyzers" />
        <dependency id="System.Text.Json" version="10.0.12" exclude="Build,Analyzers" />
        <dependency id="System.Threading.Channels" version="10.0.12" exclude="Build,Analyzers" />
        <dependency id="System.Threading.Tasks.Extensions" version="4.6.3" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.1">
        <dependency id="Microsoft.Bcl.AsyncInterfaces" version="10.0.12" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Bcl.TimeProvider" version="10.0.12" exclude="Build,Analyzers" />
        <dependency id="System.Runtime.CompilerServices.Unsafe" version="6.1.2" exclude="Build,Analyzers" />
        <dependency id="System.Text.Json" version="10.0.12" exclude="Build,Analyzers" />
        <dependency id="System.Threading.Channels" version="10.0.12" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>